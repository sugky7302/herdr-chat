{
  "name": "herdr-vscode",
  "displayName": "herdr Agents",
  "description": "%extension.description%",
  "version": "0.5.0",
  "publisher": "arvin",
  "repository": {
    "type": "git",
    "url": "https://github.com/sugky7302/herdr-chat.git"
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "herdr",
          "title": "herdr",
          "icon": "media/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "type": "webview",
          "id": "herdr.chat",
          "name": "herdr"
        }
      ]
    },
    "commands": [
      {
        "command": "herdr.refresh",
        "title": "%herdr.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.history",
        "title": "%herdr.history.title%",
        "icon": "$(history)"
      },
      {
        "command": "herdr.newAgent",
        "title": "%herdr.newAgent.title%",
        "icon": "$(add)"
      },
      {
        "command": "herdr.nextAgent",
        "title": "%herdr.nextAgent.title%"
      },
      {
        "command": "herdr.previousAgent",
        "title": "%herdr.previousAgent.title%"
      },
      {
        "command": "herdr.enableClaudeUsage",
        "title": "%herdr.enableClaudeUsage.title%"
      },
      {
        "command": "herdr.disableClaudeUsage",
        "title": "%herdr.disableClaudeUsage.title%"
      },
      {
        "command": "herdr.settings",
        "title": "%herdr.settings.title%",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "herdr.nextAgent",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "focusedView == herdr.chat"
      },
      {
        "command": "herdr.previousAgent",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "focusedView == herdr.chat"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "herdr.history",
          "when": "view == herdr.chat",
          "group": "navigation@1"
        },
        {
          "command": "herdr.newAgent",
          "when": "view == herdr.chat",
          "group": "navigation@2"
        },
        {
          "command": "herdr.refresh",
          "when": "view == herdr.chat",
          "group": "navigation@3"
        },
        {
          "command": "herdr.settings",
          "when": "view == herdr.chat",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "herdr",
      "properties": {
        "herdr.claudeMemUrl": {
          "type": "string",
          "default": "",
          "description": "%herdr.claudeMemUrl.description%"
        },
        "herdr.claudeMemSettingsPath": {
          "type": "string",
          "default": "",
          "description": "%herdr.claudeMemSettingsPath.description%"
        },
        "herdr.collaborationNodePath": {
          "type": "string",
          "default": "node",
          "description": "%herdr.collaborationNodePath.description%"
        },
        "herdr.socketPath": {
          "type": "string",
          "default": "",
          "description": "%herdr.socketPath.description%"
        },
        "herdr.transcriptLines": {
          "type": "number",
          "default": 400,
          "description": "%herdr.transcriptLines.description%"
        },
        "herdr.agentDefaults": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "markdownDescription": "%herdr.agentDefaults.description%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              }
            }
          }
        },
        "herdr.agentPresets": {
          "type": "array",
          "description": "%herdr.agentPresets.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%herdr.agentPresets.id.description%"
              },
              "label": {
                "type": "string",
                "description": "%herdr.agentPresets.label.description%"
              },
              "kind": {
                "type": "string",
                "description": "%herdr.agentPresets.kind.description%"
              },
              "command": {
                "type": "string",
                "description": "%herdr.agentPresets.command.description%"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%herdr.agentPresets.args.description%"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%herdr.agentPresets.models.description%"
              },
              "efforts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%herdr.agentPresets.efforts.description%"
              },
              "defaultModel": {
                "type": "string"
              },
              "defaultEffort": {
                "type": "string"
              },
              "modelArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%herdr.agentPresets.modelArgs.description%"
              },
              "effortArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%herdr.agentPresets.effortArgs.description%"
              },
              "switchModel": {
                "type": "string",
                "description": "%herdr.agentPresets.switchModel.description%"
              },
              "switchEffort": {
                "type": "string",
                "description": "%herdr.agentPresets.switchEffort.description%"
              },
              "switchStyle": {
                "type": "string",
                "enum": [
                  "command",
                  "codex-menu"
                ],
                "description": "%herdr.agentPresets.switchStyle.description%"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "%herdr.agentPresets.enabled.description%"
              },
              "slashCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%herdr.agentPresets.slashCommands.description%"
              }
            }
          },
          "default": [
            {
              "id": "claude",
              "label": "Claude",
              "kind": "claude",
              "models": [
                "opus",
                "sonnet",
                "haiku"
              ],
              "efforts": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "modelArgs": [
                "--model",
                "{model}"
              ],
              "effortArgs": [
                "--effort",
                "{effort}"
              ],
              "switchModel": "/model {model}",
              "switchEffort": "/effort {effort}"
            },
            {
              "id": "codex",
              "label": "Codex",
              "kind": "codex",
              "models": [
                "gpt-6.2-sol",
                "gpt-6.2-astra",
                "gpt-6.1-terra",
                "gpt-6.1-sol",
                "gpt-6-astra"
              ],
              "efforts": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ],
              "modelArgs": [
                "-m",
                "{model}"
              ],
              "effortArgs": [
                "-c",
                "model_reasoning_effort=\"{effort}\""
              ],
              "switchStyle": "codex-menu"
            },
            {
              "id": "deepseek",
              "label": "DeepSeek",
              "command": "'/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh'",
              "models": [],
              "efforts": []
            },
            {
              "id": "antigravity",
              "label": "Antigravity",
              "kind": "agy",
              "models": [
                "gemini-4-argon"
              ],
              "efforts": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "modelArgs": [
                "--model",
                "{model}"
              ],
              "effortArgs": [
                "--effort",
                "{effort}"
              ],
              "switchModel": "/model {model}",
              "switchEffort": "/effort {effort}"
            }
          ],
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.mts",
    "package": "npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.105.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0"
  }
}
